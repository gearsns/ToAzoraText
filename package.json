{
  "name": "toazoratext",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:narou": "cross-env SITE_NAME=narou vite build",
    "build:kakuyomu": "cross-env SITE_NAME=kakuyomu vite build",
    "build:pixiv": "cross-env SITE_NAME=pixiv vite build",
    "build": "npm run clean && npm run build:narou && npm run build:kakuyomu && npm run build:pixiv",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest --project=node-unit",
    "test:run": "vitest run --project=node-unit",
    "test:dom": "vitest run --project=dom-unit",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
